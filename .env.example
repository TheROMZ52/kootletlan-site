# --- Site -------------------------------------------------------------
# Public URL of the website (used for links/SEO). On Vercel it is detected automatically.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SERVER_ADDRESS=play.kootletland.kal.how
# Optional: community link (defaults to https://rubika.ir/kootletland)
NEXT_PUBLIC_RUBIKA_URL=

# --- Supabase (accounts, news, tickets) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Layerbase MariaDB (player stats, store) ----------------------------
# Keep the real credential only in Vercel Environment Variables.
LAYERBASE_API_URL=mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED

# Optional HTTP query API fallback (only used when LAYERBASE_API_URL is not set)
LAYERBASE_QUERY_API_URL=
LAYERBASE_API_KEY=
LAYERBASE_DATABASE_ID=
